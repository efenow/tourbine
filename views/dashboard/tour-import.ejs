<%- include('../partials/header', { title }) %>
<main class="container py-5">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
      <li class="breadcrumb-item active">Import Tour</li>
    </ol>
  </nav>

  <div class="card mx-auto" style="max-width: 680px;">
    <div class="card-header">
      <h5 class="mb-0"><i class="bi bi-upload"></i> Import Full Tour</h5>
    </div>
    <div class="card-body">
      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <p class="text-muted small">Upload a <code>.tourbine.json</code> export to import the tour, rooms, hotspots, info points, and media files.</p>
      <form method="POST" action="/dashboard/tours/import?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label" for="tour_file">Export file</label>
          <input id="tour_file" name="tour_file" class="form-control" type="file" accept=".json,.tourbine.json,application/json" required>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-primary" type="submit"><i class="bi bi-upload"></i> Import</button>
          <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</main>
<%- include('../partials/footer', {}) %>
